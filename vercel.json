{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/(build|css|js|images|favicon.ico|robots.txt)(.*)",
      "dest": "/$1$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "APP_KEY": "base64:BxNxbtxlwrp5bMbBQVYoI8IWYzjDgyg03MDLQ3ocKzA=",
    "DB_CONNECTION": "sqlite",
    "APP_MAINTENANCE_DRIVER": "file",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie",
    "CACHE_STORE": "file"
  }
}